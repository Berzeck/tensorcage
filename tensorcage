asyncio.run(main())
TENSORCAGE_NATIVE_WS_PY
}

########################################
# Deep doctor mode
########################################

run_doctor() {
  local pass_count=0
  local warn_count=0
  local fail_count=0
  local path=""
  local service=""
  local output=""
  local target_user=""
  local target_home=""

  if ! systemctl is-active --quiet tensorcage-nft.service 2>/dev/null \
    || ! systemctl is-active --quiet sockd 2>/dev/null \
    || ! systemctl is-active --quiet unbound 2>/dev/null; then
    echo
    echo "${APP_NAME} Doctor ${APP_VERSION}"
    echo "================================================="
    echo "Installed: YES"
    echo "Enabled:   NO"
    echo "Health:    NOT APPLICABLE"
    echo "Recommendation: sudo /usr/local/bin/tensorcage enable"
    return 2
  fi

  doctor_pass() {
    printf 'PASS  %s\n' "$1"
    pass_count=$((pass_count + 1))
  }

  doctor_warn() {
    printf 'WARN  %s\n' "$1"
    warn_count=$((warn_count + 1))
  }

  doctor_fail() {
    printf 'FAIL  %s\n' "$1"
    fail_count=$((fail_count + 1))
  }

  echo
  echo "${APP_NAME} Doctor ${APP_VERSION}"
  echo "================================================="

  echo
  echo "[Managed files]"
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ -f "$path" && ! -L "$path" ]]; then
      doctor_pass "regular managed file: $path"
    else
      doctor_fail "missing or unsafe managed file: $path"
    fi
  done < <(managed_integrity_paths)

  echo
  echo "[Configuration integrity]"
  if output="$(verify_managed_integrity_manifest 2>&1)"; then
    doctor_pass "managed configuration hashes match"
  else
    doctor_fail "managed configuration integrity mismatch"
    printf '%s\n' "$output" | sed 's/^/      /'
  fi

  echo
  echo "[Configuration parsers]"
  if /usr/sbin/unbound-checkconf /etc/unbound/unbound.conf >/dev/null 2>&1; then
    doctor_pass "Unbound configuration parses"
  else
    doctor_fail "Unbound configuration does not parse"
  fi
  if /usr/sbin/sockd -V -f /etc/sockd.conf >/dev/null 2>&1; then
    doctor_pass "Dante server configuration parses"
  else
    doctor_fail "Dante server configuration does not parse"
  fi
  if /usr/sbin/chronyd -p -f /etc/chrony.conf >/dev/null 2>&1; then
    doctor_pass "Chrony configuration parses"
  else
    doctor_fail "Chrony configuration does not parse"
  fi
  if grep -qE 'via:[[:space:]]*127[.]0[.]0[.]1[[:space:]]+port[[:space:]]*=[[:space:]]*1080' /etc/socks.conf; then
    doctor_pass "Dante client routes through 127.0.0.1:1080"
  else
    doctor_fail "Dante client route is missing"
  fi
  if grep -q "wss_proxy='socks5h://127.0.0.1:1080'" /usr/local/bin/btc \
    && ! grep -q '/usr/bin/socksify' /usr/local/bin/btc; then
    doctor_pass "btc uses native asynchronous SOCKS transport"
  else
    doctor_fail "btc native SOCKS transport is not configured"
  fi

  echo
  echo "[Services]"
  for service in firewalld sockd unbound chronyd tensorcage-nft.service; do
    if systemctl is-enabled --quiet "$service" 2>/dev/null; then
      doctor_pass "$service enabled"
    else
      doctor_fail "$service not enabled"
    fi
    if systemctl is-active --quiet "$service" 2>/dev/null; then
      doctor_pass "$service active"
    else
      doctor_fail "$service not active"
    fi
  done

  echo
  echo "[Local listeners]"
  if ss -lnt 2>/dev/null | grep -qE '127[.]0[.]0[.]1:1080[[:space:]]'; then
    doctor_pass "Dante listens on 127.0.0.1:1080"
  else
    doctor_fail "Dante listener missing on 127.0.0.1:1080"
  fi
  if ss -lntu 2>/dev/null | grep -qE '127[.]0[.]0[.]1:53[[:space:]]'; then
    doctor_pass "Unbound listens on 127.0.0.1:53"
  else
    doctor_fail "Unbound listener missing on 127.0.0.1:53"
  fi

  echo
  echo "[Firewall containment]"
  if firewall-cmd --direct --get-all-rules 2>/dev/null | grep -q 'ipv4 filter OUTPUT 100 -j DROP'; then
    doctor_pass "IPv4 terminal OUTPUT drop present"
  else
    doctor_fail "IPv4 terminal OUTPUT drop missing"
  fi
  if firewall-cmd --direct --get-all-rules 2>/dev/null | grep -q 'ipv6 filter OUTPUT 100 -j DROP'; then
    doctor_pass "IPv6 terminal OUTPUT drop present"
  else
    doctor_fail "IPv6 terminal OUTPUT drop missing"
  fi
  if nft list table inet tensorcage >/dev/null 2>&1; then
    doctor_pass "TensorCage nftables table loaded"
  else
    doctor_fail "TensorCage nftables table missing"
  fi

  echo
  echo "[DNS policy]"
  if output="$(dig @127.0.0.1 pypi.org +time=2 +tries=1 2>/dev/null)" && grep -q 'status: REFUSED' <<<"$output"; then
    doctor_pass "PyPI DNS closed"
  else
    doctor_fail "PyPI DNS is not closed"
  fi
  if output="$(dig @127.0.0.1 github.com +time=2 +tries=1 2>/dev/null)" && grep -q 'status: REFUSED' <<<"$output"; then
    doctor_pass "GitHub DNS blocked"
  else
    doctor_fail "GitHub DNS is not blocked"
  fi
  if output="$(dig @127.0.0.1 opentensor.ai +time=3 +tries=1 2>/dev/null)" && grep -q 'status: NOERROR' <<<"$output"; then
    doctor_pass "Bittensor runtime DNS allowed"
  else
    doctor_fail "Bittensor runtime DNS unavailable"
  fi

  echo
  echo "[Time synchronization]"
  if LC_ALL=C chronyc tracking 2>/dev/null | grep -q '^Leap status[[:space:]]*:[[:space:]]*Normal'; then
    doctor_pass "Chrony synchronized"
  else
    doctor_fail "Chrony not synchronized"
  fi
  if LC_ALL=C chronyc -n sources 2>/dev/null | grep -q '^\^\*'; then
    doctor_pass "Chrony selected a pinned source"
  else
    doctor_fail "Chrony has no selected source"
  fi

  echo
  echo "[Bittensor runtime]"
  if [[ -x "$PYTHON_BIN" ]]; then
    doctor_pass "TensorCage Python present"
  else
    doctor_fail "TensorCage Python missing: $PYTHON_BIN"
  fi
  if [[ -x /opt/tensorcage/venv/bin/btcli ]]; then
    doctor_pass "unified btcli executable present"
    if /opt/tensorcage/venv/bin/btcli --version >/dev/null 2>&1; then
      doctor_pass "unified btcli starts"
    else
      doctor_fail "unified btcli failed to start"
    fi
  else
    doctor_fail "unified btcli executable missing"
  fi
  if [[ -x /usr/local/bin/btc ]]; then
    doctor_pass "btc wrapper present"
  else
    doctor_fail "btc wrapper missing"
  fi
  if "$PYTHON_BIN" -c 'from importlib.metadata import version; print(version("python-socks"))' >/dev/null 2>&1; then
    doctor_pass "python-socks native proxy backend installed"
  else
    doctor_fail "python-socks native proxy backend missing"
  fi

  target_user="$(get_target_user)"
  target_home="$(get_target_home "$target_user")"
  if verify_native_bittensor_websocket "$target_user" "$target_home" >/dev/null 2>&1; then
    doctor_pass "Bittensor WebSocket handshake succeeds through native SOCKS"
  else
    doctor_fail "Bittensor WebSocket handshake through native SOCKS failed"
  fi
  if [[ -d "${target_home}/.bittensor/wallets" ]]; then
    doctor_pass "wallet directory present for ${target_user}"
  else
    doctor_warn "wallet directory not found for ${target_user}"
  fi

  echo
  echo "[Summary]"
  printf 'PASS=%d  WARN=%d  FAIL=%d\n' "$pass_count" "$warn_count" "$fail_count"
  if [[ "$fail_count" -eq 0 ]]; then
    echo "Overall: PASS"
    return 0
  fi
  echo "Overall: FAIL"
  return 1
}

run_focused_test() {
  local target="$1"
  case "$target" in
    dns)
      dig @127.0.0.1 pypi.org +time=2 +tries=1 2>/dev/null | grep -q 'status: REFUSED' \
        && echo "PASS: PyPI DNS is closed" \
        || { echo "FAIL: PyPI DNS is not closed"; return 1; }
      dig @127.0.0.1 opentensor.ai +short +time=3 +tries=1 | grep -q . \
        && echo "PASS: Bittensor runtime DNS resolves" \
        || { echo "FAIL: Bittensor runtime DNS does not resolve"; return 1; }
      ;;
    proxy)
      [[ -f /etc/socks.conf && ! -L /etc/socks.conf ]] \
        || { echo "FAIL: Dante client configuration missing"; return 1; }
      systemctl is-active --quiet sockd || { echo "FAIL: sockd inactive"; return 1; }
      grep -q 'via: 127.0.0.1 port = 1080' /etc/socks.conf \
        || { echo "FAIL: local SOCKS route missing"; return 1; }
      "$PYTHON_BIN" -c 'from importlib.metadata import version; version("python-socks")' \
        || { echo "FAIL: python-socks missing"; return 1; }
      grep -q "wss_proxy='socks5h://127.0.0.1:1080'" /usr/local/bin/btc \
        || { echo "FAIL: btc native SOCKS proxy missing"; return 1; }
      target_user="$(get_target_user)"
      target_home="$(get_target_home "$target_user")"
      verify_native_bittensor_websocket "$target_user" "$target_home" \
        || { echo "FAIL: native WebSocket path failed"; return 1; }
      echo "PASS: native asynchronous SOCKS path through Dante"
      ;;
    firewall)
      firewall-cmd --direct --get-all-rules | grep -q 'ipv4 filter OUTPUT 100 -j DROP' \
        || { echo "FAIL: IPv4 terminal drop missing"; return 1; }
      firewall-cmd --direct --get-all-rules | grep -q 'ipv6 filter OUTPUT 100 -j DROP' \
        || { echo "FAIL: IPv6 terminal drop missing"; return 1; }
      nft list table inet tensorcage >/dev/null 2>&1 \
        || { echo "FAIL: TensorCage nftables table missing"; return 1; }
      echo "PASS: firewall containment present"
      ;;
    chrony)
      LC_ALL=C chronyc tracking | grep -q '^Leap status[[:space:]]*: Normal' \
        || { echo "FAIL: Chrony not synchronized"; return 1; }
      LC_ALL=C chronyc -n sources | grep -q '^\^\*' \
        || { echo "FAIL: no selected Chrony source"; return 1; }
      echo "PASS: Chrony synchronized"
      ;;
    python)
      [[ -x "$PYTHON_BIN" && -x /opt/tensorcage/venv/bin/btcli ]] \
        || { echo "FAIL: TensorCage Python or btcli missing"; return 1; }
      /opt/tensorcage/venv/bin/btcli --version >/dev/null \
        || { echo "FAIL: unified btcli does not start"; return 1; }
      echo "PASS: TensorCage Python and btcli runtime"
      ;;
    integrity)
      verify_managed_integrity_manifest \
        && echo "PASS: managed content and metadata integrity" \
        || return 1
      ;;
  esac
}

