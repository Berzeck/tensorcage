  set_kv "NETCONFIG_DNS_POLICY" "STATIC" /etc/sysconfig/network/config
  set_kv "NETCONFIG_DNS_STATIC_SERVERS" "1.1.1.1 8.8.8.8" /etc/sysconfig/network/config
