update_bittensor() {
  require_enabled_state
  local bittensor_version="$1"
  local supplied_lock_file="$2"
  local lock_hash_expected="$3"

  local target_user
  local target_home
  local tmpdir=""
  local lock_copy=""
  local wheel_dir=""

  require_baseline_install

  target_user="$(get_target_user)"
  target_home="$(get_target_home "$target_user")"

  if [[ "$target_user" == "root" ]]; then
    echo "Refusing to install Bittensor as root."
    echo "Run with sudo from a normal user, or set TENSORCAGE_USER=<username>."
    exit 1
  fi

  validate_bittensor_lock "$supplied_lock_file" "$lock_hash_expected" "$bittensor_version"

  cleanup() {
    log "Re-closing PyPI access"
    apply_policy 0 0 || true
    if [[ -n "${tmpdir:-}" && -d "${tmpdir:-}" ]]; then
      rm -rf "${tmpdir:-}"
    fi
  }
  trap cleanup EXIT

  log "Target user for update: ${target_user}"
  id "$target_user" >/dev/null 2>&1 || {
    echo "Target user does not exist: $target_user"
    exit 1
  }

  log "Update mode: complete hash-locked unified Bittensor wheel set"

  log "Stopping common runtimes and network utilities before opening update window"
  pkill -u "$target_user" -f "python" 2>/dev/null || true
  pkill -u "$target_user" -f "btcli" 2>/dev/null || true
  pkill -u "$target_user" -f "node" 2>/dev/null || true
  pkill -u "$target_user" -f "ruby" 2>/dev/null || true
  pkill -u "$target_user" -f "curl" 2>/dev/null || true
  pkill -u "$target_user" -f "wget" 2>/dev/null || true

  render_dante_client_conf

  tmpdir="$(mktemp -d /tmp/bittensor-update.XXXXXX)"
  chown "$target_user":"$(id -gn "$target_user")" "$tmpdir"
  chmod 0700 "$tmpdir"
  lock_copy="${tmpdir}/requirements.lock"
  wheel_dir="${tmpdir}/wheels"
  mkdir -p "$wheel_dir"
  chown "$target_user":"$(id -gn "$target_user")" "$wheel_dir"
  chmod 0700 "$wheel_dir"
  install -o root -g root -m 0644 "$supplied_lock_file" "$lock_copy"

  log "Temporarily opening PyPI access"
  apply_policy 1 0
  verify_socksified_python_egress "$target_user" "$target_home"

  log "Downloading the exact fully hash-locked wheel set"
  runuser -u "$target_user" -- env \
    HOME="$target_home" \
    PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    SOCKS_CONF='/etc/socks.conf' \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    /usr/bin/socksify "$PYTHON_BIN" -m pip download \
      --require-hashes \
      --only-binary=:all: \
      --dest "$wheel_dir" \
      --requirement "$lock_copy"

  log "Verifying exact wheel membership and every SHA256"
  verify_downloaded_wheel_set "$lock_copy" "$wheel_dir"

  log "Removing superseded standalone CLI and wallet packages"
  env \
    HOME="$target_home" \
    PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    "$PYTHON_BIN" -m pip uninstall -y \
      bittensor-cli \
      bittensor-wallet || true

  log "Installing only the verified local wheel set"
  env \
    HOME="$target_home" \
    PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    "$PYTHON_BIN" -m pip install \
      --no-index \
      --find-links "$wheel_dir" \
      --require-hashes \
      --requirement "$lock_copy"

  log "Verifying the installed Bittensor version"
  BITTENSOR_EXPECTED_VERSION="$bittensor_version" \
    "$PYTHON_BIN" - <<'TENSORCAGE_VERIFY_PY'
import os
from importlib.metadata import PackageNotFoundError, version

expected = os.environ["BITTENSOR_EXPECTED_VERSION"]
actual = version("bittensor")
print(f"bittensor: {actual}")
if actual != expected:
    raise SystemExit(f"Installed Bittensor version mismatch: expected {expected}, got {actual}")

try:
    socks_version = version("python-socks")
except PackageNotFoundError as exc:
    raise SystemExit("Required native SOCKS backend is not installed: python-socks") from exc
print(f"python-socks: {socks_version}")

for legacy in ("bittensor-cli", "bittensor-wallet"):
    try:
        legacy_version = version(legacy)
    except PackageNotFoundError:
        print(f"{legacy}: not installed")
    else:
        raise SystemExit(f"Superseded package still installed: {legacy} {legacy_version}")
TENSORCAGE_VERIFY_PY

  [[ -x "/opt/tensorcage/venv/bin/btcli" ]] || {
    echo "Bittensor installed, but /opt/tensorcage/venv/bin/btcli was not created."
    exit 1
  }

  runuser -u "$target_user" -- env \
    HOME="$target_home" \
    PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    "/opt/tensorcage/venv/bin/btcli" --version

  install_btc_wrapper

  trap - EXIT
  cleanup
  refresh_managed_integrity_manifest

  log "Complete hash-locked unified Bittensor update completed"
}

