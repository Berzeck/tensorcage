########################################
# Managed configuration integrity
########################################

managed_integrity_paths() {
  cat <<'EOF'
/etc/unbound/unbound.conf
/etc/unbound/allowlist/domains.conf
/etc/sockd.conf
/etc/socks.conf
/etc/chrony.conf
/usr/local/bin/btc
/usr/local/bin/tensorcage
/usr/local/sbin/tensorcage-nft-apply
/etc/systemd/system/tensorcage-nft.service
EOF
}

refresh_managed_integrity_manifest() {
  local tmpfile=""
  local path=""

  install -d -o root -g root -m 0700 "$TENSORCAGE_STATE_DIR"
  tmpfile="$(mktemp "${TENSORCAGE_STATE_DIR}/managed-configs.v2.tsv.XXXXXX")"

  printf '# tensorcage-managed-manifest-v%s\n' "$MANIFEST_FORMAT_VERSION" > "$tmpfile"
  printf '# policy=%s configuration=%s app=%s\n' \
    "$POLICY_VERSION" "$CONFIGURATION_VERSION" "$APP_VERSION" >> "$tmpfile"
  printf '# sha256\\tsize\\tmode\\towner\\tgroup\\tpath\n' >> "$tmpfile"

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ ! -f "$path" || -L "$path" ]]; then
      echo "Cannot record integrity for missing or unsafe managed file: $path"
      rm -f "$tmpfile"
      return 1
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(sha256_file "$path")" \
      "$(stat -c '%s' "$path")" \
      "$(stat -c '%a' "$path")" \
      "$(stat -c '%U' "$path")" \
      "$(stat -c '%G' "$path")" \
      "$path" >> "$tmpfile"
  done < <(managed_integrity_paths)

  chown root:root "$tmpfile"
  chmod 0600 "$tmpfile"
  mv -f "$tmpfile" "$INTEGRITY_MANIFEST"
}

verify_managed_integrity_manifest() {
  [[ -f "$INTEGRITY_MANIFEST" && ! -L "$INTEGRITY_MANIFEST" ]] || {
    echo "Integrity manifest is missing or unsafe: $INTEGRITY_MANIFEST"
    return 1
  }

  "$PYTHON_BIN" - "$INTEGRITY_MANIFEST" <<'TENSORCAGE_PY'
import hashlib
import os
import stat
import sys
from pathlib import Path

manifest = Path(sys.argv[1])
failures: list[str] = []
for lineno, raw in enumerate(manifest.read_text(encoding="utf-8").splitlines(), 1):
    if not raw or raw.startswith("#"):
        continue
    fields = raw.split("\t")
    if len(fields) != 6:
        failures.append(f"line {lineno}: malformed manifest record")
        continue
    expected_hash, expected_size, expected_mode, expected_owner, expected_group, filename = fields
    path = Path(filename)
    try:
        st = path.lstat()
    except FileNotFoundError:
        failures.append(f"MISSING: {filename}")
        continue
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        failures.append(f"UNSAFE TYPE: {filename}")
        continue
    actual_hash = hashlib.sha256(path.read_bytes()).hexdigest()
    actual_size = str(st.st_size)
    actual_mode = format(stat.S_IMODE(st.st_mode), "o")
    import pwd, grp
    actual_owner = pwd.getpwuid(st.st_uid).pw_name
    actual_group = grp.getgrgid(st.st_gid).gr_name
    checks = (
        ("SHA256", expected_hash, actual_hash),
        ("SIZE", expected_size, actual_size),
        ("MODE", expected_mode, actual_mode),
        ("OWNER", expected_owner, actual_owner),
        ("GROUP", expected_group, actual_group),
    )
    for label, expected, actual in checks:
        if expected != actual:
            failures.append(f"{label} MISMATCH: {filename}: expected={expected} actual={actual}")
if failures:
    print("\n".join(failures))
    raise SystemExit(1)
TENSORCAGE_PY
}

show_managed_diff() {
  echo
  echo "${APP_NAME} managed configuration diff"
  echo "================================================="
  if verify_managed_integrity_manifest; then
    echo "No managed-file content or metadata drift detected."
    return 0
  fi
  echo
  echo "Drift was detected. The lines above identify exact content or metadata differences."
  echo "TensorCage does not overwrite drift in diff mode. Run policy-sync/time-sync only after review."
  return 1
}

verify_native_bittensor_websocket() {
  local target_user="$1"
