  fi
  echo
  # ------------------------------------

  echo "[Unbound recent logs]"
  journalctl -u unbound --no-pager -n 20 2>/dev/null || echo "Could not read unbound journal"
  echo

  echo
  echo "[Managed configuration integrity]"
  if verify_managed_integrity_manifest >/dev/null 2>&1; then
    echo "PASS: managed files match ${INTEGRITY_MANIFEST}"
    echo "Manifest SHA256: $(sha256_file "$INTEGRITY_MANIFEST")"
  else
    echo "WARNING: managed files differ or the integrity manifest is missing."
    verify_managed_integrity_manifest 2>&1 || true
  fi

  echo
  echo "[Installed Bittensor packages]"
  target_user="$(get_target_user)"
  target_home="$(get_target_home "$target_user")"

  if id "$target_user" >/dev/null 2>&1 && command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    runuser -u "$target_user" -- env \
      HOME="$target_home" \
      PATH="$target_home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
      "$PYTHON_BIN" - <<'TENSORCAGE_PY' 2>/dev/null || echo "Could not read Python package versions"
from importlib.metadata import PackageNotFoundError, version

for pkg in ("bittensor", "bittensor-cli", "bittensor-wallet"):
    try:
        print(f"{pkg}: {version(pkg)}")
    except PackageNotFoundError:
        print(f"{pkg}: not installed")
TENSORCAGE_PY
  else
    echo "Could not determine target user or Python interpreter"
  fi

  echo
  echo "Info check completed."
}

time_sync_command() {
  require_baseline_install
  log "Creating rollback snapshot before time synchronization"
  create_rollback_snapshot "time-sync" >/dev/null
  configure_chrony
  refresh_managed_integrity_manifest
}

