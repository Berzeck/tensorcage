  log "Applying openSUSE package updates"
  zypper update -y

  trap - EXIT
  cleanup

  log "OS update completed successfully."
}

os_upgrade() {
  require_baseline_install

  cleanup() {
    log "Re-closing openSUSE maintenance gate"
    set_kv "NETCONFIG_DNS_POLICY" "STATIC" /etc/sysconfig/network/config
    set_kv "NETCONFIG_DNS_STATIC_SERVERS" "${DNS_LOCAL_IP}" /etc/sysconfig/network/config
