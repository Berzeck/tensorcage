resolve_ipv4_hosts() {
  local array_name="$1"
  local -n hosts_ref="$array_name"
  local host
  local address
  local addresses=()

  require_command getent

  for host in "${hosts_ref[@]}"; do
    while IFS= read -r address; do
      [[ -n "$address" ]] && addresses+=("$address")
    done < <(
      getent ahostsv4 "$host" 2>/dev/null |
        awk '$2 == "STREAM" {print $1}' |
        sort -u
    )
  done

  if [[ "${#addresses[@]}" -eq 0 ]]; then
    echo "No IPv4 addresses could be resolved for: ${hosts_ref[*]}" >&2
    return 1
  fi

  printf '%s\n' "${addresses[@]}" | sort -u
}

append_dante_pass_rule() {
  local destination="$1"
  local port="$2"
  local file="$3"

  cat >> "$file" <<EOF
socks pass {
    from: 127.0.0.1/32 to: ${destination} port = ${port}
    command: connect
    log: connect error
}
EOF
}

