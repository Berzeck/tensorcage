########################################
# Usage / argument parsing
########################################

usage() {
  cat <<EOF
${APP_NAME} ${APP_VERSION}

Usage:
  ${CLI_NAME} install
  ${CLI_NAME} enable
  ${CLI_NAME} disable [--dry-run]
  ${CLI_NAME} status
  ${CLI_NAME} lock-create bittensor=<version> output=<path>
  ${CLI_NAME} lock-verify bittensor=<version> lock=<path> lock_hash=<sha256>
  ${CLI_NAME} update bittensor=<version> lock=<path> lock_hash=<sha256>
  ${CLI_NAME} doctor
  ${CLI_NAME} info
  ${CLI_NAME} uninstall [--dry-run]
  ${CLI_NAME} help
  ${CLI_NAME} version

Lifecycle:
  install     Fresh installation and immediate enablement
  enable      Reapply all containment controls and validate the enabled state
  disable     Enter maintenance mode while preserving TensorCage and Bittensor
  status      Show installed, enabled, and health state without changing anything
  uninstall   Remove TensorCage application/runtime state while preserving wallets

Security and updates:
  lock-create Create a complete hash-locked Bittensor dependency manifest
  lock-verify Validate a lock manifest without downloading or installing anything
  update      Install only the exact wheel set approved by a validated lock manifest
  doctor      Run deep, read-only validation of all enabled security components
  info        Show detailed runtime, policy, integrity, and activity information

Examples:
  sudo ${CLI_NAME} install
  sudo ${CLI_NAME} disable --dry-run
  sudo ${CLI_NAME} disable
  sudo ${CLI_NAME} enable
  sudo ${CLI_NAME} status
  sudo ${CLI_NAME} doctor
  sudo ${CLI_NAME} uninstall --dry-run

  ${CLI_NAME} lock-create \
    bittensor=11.0.1 \
    output=./bittensor-11.0.1-cp313-linux-x86_64.lock

  sudo ${CLI_NAME} lock-verify \
    bittensor=11.0.1 \
    lock=./bittensor-11.0.1-cp313-linux-x86_64.lock \
    lock_hash=<sha256-of-lock-file>

  sudo ${CLI_NAME} update \
    bittensor=11.0.1 \
    lock=./bittensor-11.0.1-cp313-linux-x86_64.lock \
    lock_hash=<sha256-of-lock-file>

Operator maintenance commands from 1.x are intentionally hidden from the public
CLI. Existing scripts may temporarily use the compatibility aliases prefixed
with an underscore; they are unsupported implementation details.
EOF
}
validate_version() {
  local v="$1"
  [[ "$v" =~ ^[0-9]+(\.[0-9]+){1,3}([A-Za-z0-9._-]+)?$ ]]
}

validate_sha256() {
  local h="$1"
  [[ "$h" =~ ^[A-Fa-f0-9]{64}$ ]]
}

COMMAND="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

BITTENSOR_VERSION=""
LOCK_FILE=""
LOCK_HASH=""
LOCK_OUTPUT=""
DISABLE_DRY_RUN="0"
UNINSTALL_DRY_RUN="0"
TEST_TARGET=""

case "${COMMAND}" in
  install|enable|status|doctor|info)
    [[ $# -eq 0 ]] || { echo "${COMMAND} does not accept extra arguments"; usage; exit 1; }
    ;;
  disable)
    [[ $# -le 1 ]] || { echo "disable accepts only optional --dry-run"; usage; exit 1; }
    if [[ $# -eq 1 ]]; then
      [[ "$1" == "--dry-run" ]] || { echo "Unknown disable argument: $1"; exit 1; }
      DISABLE_DRY_RUN="1"
    fi
    ;;
  uninstall)
    [[ $# -le 1 ]] || { echo "uninstall accepts only optional --dry-run"; usage; exit 1; }
    if [[ $# -eq 1 ]]; then
      [[ "$1" == "--dry-run" ]] || { echo "Unknown uninstall argument: $1"; exit 1; }
      UNINSTALL_DRY_RUN="1"
    fi
    ;;
  lock-create)
    for arg in "$@"; do
      case "$arg" in
        bittensor=*) BITTENSOR_VERSION="${arg#bittensor=}" ;;
        output=*) LOCK_OUTPUT="${arg#output=}" ;;
        *) echo "Unknown lock-create argument: $arg"; usage; exit 1 ;;
      esac
    done
    [[ -n "$BITTENSOR_VERSION" ]] || { echo "Missing required arg: bittensor=<version>"; exit 1; }
    [[ -n "$LOCK_OUTPUT" ]] || { echo "Missing required arg: output=<path>"; exit 1; }
    validate_version "$BITTENSOR_VERSION" || { echo "Invalid bittensor version: $BITTENSOR_VERSION"; exit 1; }
    ;;
  lock-verify|update)
    for arg in "$@"; do
      case "$arg" in
        bittensor=*) BITTENSOR_VERSION="${arg#bittensor=}" ;;
        lock=*) LOCK_FILE="${arg#lock=}" ;;
        lock_hash=*) LOCK_HASH="${arg#lock_hash=}" ;;
        *) echo "Unknown ${COMMAND} argument: $arg"; usage; exit 1 ;;
      esac
    done
    [[ -n "$BITTENSOR_VERSION" ]] || { echo "Missing required arg: bittensor=<version>"; exit 1; }
    [[ -n "$LOCK_FILE" ]] || { echo "Missing required arg: lock=<path>"; exit 1; }
    [[ -n "$LOCK_HASH" ]] || { echo "Missing required arg: lock_hash=<sha256>"; exit 1; }
    validate_version "$BITTENSOR_VERSION" || { echo "Invalid bittensor version: $BITTENSOR_VERSION"; exit 1; }
    validate_sha256 "$LOCK_HASH" || { echo "Invalid lock-file SHA256: $LOCK_HASH"; exit 1; }
    ;;
  _policy-sync|_time-sync|_os-update|_os-upgrade|_diff|_selftest)
    [[ $# -eq 0 ]] || { echo "${COMMAND} does not accept extra arguments"; exit 1; }
    ;;
  _test)
    [[ $# -eq 1 ]] || { echo "_test requires one target"; exit 1; }
    TEST_TARGET="$1"
    case "$TEST_TARGET" in dns|proxy|firewall|chrony|python|integrity) ;; *) exit 1 ;; esac
    ;;
  help|-h|--help|"") usage; exit 0 ;;
  version|-v|--version)
    cat <<EOF
${APP_NAME}
Version: ${APP_VERSION}
Policy: ${POLICY_VERSION}
Configuration: ${CONFIGURATION_VERSION}
Manifest format: ${MANIFEST_FORMAT_VERSION}
Python: ${PYTHON_BIN}
EOF
    exit 0
    ;;
  *) echo "Unknown command: ${COMMAND}"; echo; usage; exit 1 ;;
esac
########################################
# Helpers
