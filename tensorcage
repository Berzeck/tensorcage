########################################
# Hash-locked Bittensor manifests
########################################

create_bittensor_lock() {
  local bittensor_version="$1"
  local output_path="$2"
  local tmpdir=""
  local output_dir=""
  local output_abs=""
  local temp_lock=""
  local lock_python=""
  local target_user=""
  local target_home=""
  local target_group=""
  local secured_mode='0'

  # EXIT traps run after function-local scope may have been unwound.
  # Cleanup state must therefore remain globally reachable until the trap
  # is explicitly removed.
  TC_LOCK_CREATE_POLICY_OPENED='0'
  TC_LOCK_CREATE_TMPDIR=''
  TC_LOCK_CREATE_TEMP_LOCK=''

  # Two supported lock-creation modes:
  #   1. Normal user on an unrestricted trusted host: direct PyPI download.
  #   2. Root (normally via sudo) on an installed TensorCage host: temporary
  #      PyPI allowlist, Dante-only egress, then automatic re-closure.
  if [[ $EUID -eq 0 ]] \
    && [[ -f /etc/sockd.conf && ! -L /etc/sockd.conf ]] \
    && [[ -f /etc/unbound/unbound.conf && ! -L /etc/unbound/unbound.conf ]] \
    && [[ -x /usr/sbin/sockd ]] \
    && [[ -x /usr/sbin/unbound-checkconf ]] \
    && [[ -x /usr/bin/socksify ]]; then
    secured_mode='1'
  fi

  if [[ "$secured_mode" == '1' ]]; then
    require_baseline_install
    require_command runuser
    require_command chown
    require_command chmod
    require_command systemctl

    lock_python="$PYTHON_BIN"
    [[ -x "$lock_python" ]] || {
      echo "TensorCage Python is missing or not executable: $lock_python"
      exit 1
    }

    target_user="$(get_target_user)"
    if [[ "$target_user" == 'root' ]]; then
      echo "Refusing to create a trusted-user lock as root without an explicit owner."
      echo "Run with sudo from a normal user, or set TENSORCAGE_USER=<username>."
      exit 1
    fi
    id "$target_user" >/dev/null 2>&1 || {
      echo "Target user does not exist: $target_user"
      exit 1
    }
    target_home="$(get_target_home "$target_user")"
    target_group="$(id -gn "$target_user")"
  else
    lock_python="$(command -v python3 || true)"
    [[ -n "$lock_python" && -x "$lock_python" ]] || {
      echo "python3 is required to create a lock manifest."
      exit 1
    }
    target_user="$(id -un)"
    target_home="$HOME"
    target_group="$(id -gn)"
  fi

  if ! "$lock_python" -m pip --version >/dev/null 2>&1; then
    echo "pip is required for the selected Python interpreter: $lock_python"
    exit 1
  fi

  if [[ -L "$output_path" ]]; then
    echo "Refusing to replace symbolic link: $output_path"
    exit 1
  fi

  output_dir="$(dirname -- "$output_path")"
  [[ -d "$output_dir" ]] || {
    echo "Output directory does not exist: $output_dir"
    exit 1
  }

  output_abs="$(cd "$output_dir" && pwd -P)/$(basename -- "$output_path")"

  if [[ -e "$output_abs" && ! -f "$output_abs" ]]; then
    echo "Refusing to replace non-regular output path: $output_abs"
    exit 1
  fi
  if [[ -L "$output_abs" ]]; then
    echo "Refusing to replace symbolic link: $output_abs"
    exit 1
  fi

  tmpdir="$(mktemp -d /tmp/tensorcage-lock-create.XXXXXX)"
  temp_lock="$(mktemp "${output_dir}/.tensorcage-lock.XXXXXX")"

  TC_LOCK_CREATE_TMPDIR="$tmpdir"
  TC_LOCK_CREATE_TEMP_LOCK="$temp_lock"

  cleanup_lock_create() {
    local cleanup_status='0'

    if [[ "${TC_LOCK_CREATE_POLICY_OPENED:-0}" == '1' ]]; then
      log "Re-closing PyPI access after lock creation"
      apply_policy 0 0 || cleanup_status='1'
      TC_LOCK_CREATE_POLICY_OPENED='0'
    fi

    if [[ -n "${TC_LOCK_CREATE_TMPDIR:-}" ]]; then
      rm -rf -- "$TC_LOCK_CREATE_TMPDIR"
      TC_LOCK_CREATE_TMPDIR=''
    fi

    if [[ -n "${TC_LOCK_CREATE_TEMP_LOCK:-}" ]]; then
      rm -f -- "$TC_LOCK_CREATE_TEMP_LOCK"
      TC_LOCK_CREATE_TEMP_LOCK=''
    fi

    if [[ "$cleanup_status" != '0' ]]; then
      echo "WARNING: Failed to fully restore the closed PyPI policy."
      return 1
    fi
  }
  trap cleanup_lock_create EXIT

  if [[ "$secured_mode" == '1' ]]; then
    log "Lock-create mode: secured TensorCage host"
    log "Target user for lock creation: ${target_user}"

    chown "$target_user:$target_group" "$tmpdir"
    chmod 0700 "$tmpdir"

    render_dante_client_conf

    log "Temporarily opening PyPI access for lock creation"
    # Mark the policy window before applying it so the EXIT trap attempts a
    # fail-closed restoration even if policy application fails partway.
    TC_LOCK_CREATE_POLICY_OPENED='1'
    apply_policy 1 0

    verify_socksified_python_egress "$target_user" "$target_home"

    log "Downloading the exact Bittensor ${bittensor_version} wheel set through Dante"
    runuser -u "$target_user" -- env \
      HOME="$target_home" \
      PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
      SOCKS_CONF='/etc/socks.conf' \
      PIP_DISABLE_PIP_VERSION_CHECK=1 \
      /usr/bin/socksify "$lock_python" -m pip download \
        --disable-pip-version-check \
        --only-binary=:all: \
        --dest "$tmpdir" \
        "bittensor==${bittensor_version}" \
        'python-socks[asyncio]'
  else
    log "Lock-create mode: unrestricted trusted host"
    log "Downloading the exact Bittensor ${bittensor_version} wheel set"
    "$lock_python" -m pip download \
      --disable-pip-version-check \
      --only-binary=:all: \
      --dest "$tmpdir" \
      "bittensor==${bittensor_version}" \
      'python-socks[asyncio]'
  fi

  log "Generating a complete SHA256 lock manifest"
  TENSORCAGE_LOCK_VERSION='1' \
  TENSORCAGE_BITTENSOR_VERSION="$bittensor_version" \
  TENSORCAGE_WHEEL_DIR="$tmpdir" \
  TENSORCAGE_LOCK_OUTPUT="$temp_lock" \
    "$lock_python" - <<'TENSORCAGE_CREATE_LOCK_PY'
import email
import hashlib
import os
import platform
import re
import sys
import zipfile
from pathlib import Path

wheel_dir = Path(os.environ["TENSORCAGE_WHEEL_DIR"])
output = Path(os.environ["TENSORCAGE_LOCK_OUTPUT"])
expected_bittensor = os.environ["TENSORCAGE_BITTENSOR_VERSION"]
lock_version = os.environ["TENSORCAGE_LOCK_VERSION"]


def canonicalize(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


records: dict[str, tuple[str, str, str]] = {}
wheel_files = sorted(wheel_dir.glob("*.whl"))
if not wheel_files:
    raise SystemExit("No wheel files were downloaded")

for wheel in wheel_files:
    if wheel.is_symlink() or not wheel.is_file():
        raise SystemExit(f"Unsafe wheel entry: {wheel}")

    with zipfile.ZipFile(wheel) as archive:
        metadata_names = [
            name for name in archive.namelist()
            if name.endswith(".dist-info/METADATA")
        ]
        if len(metadata_names) != 1:
            raise SystemExit(f"Expected one METADATA file in {wheel.name}")
        message = email.message_from_bytes(archive.read(metadata_names[0]))

    raw_name = message.get("Name")
    version = message.get("Version")
    if not raw_name or not version:
        raise SystemExit(f"Missing Name or Version metadata in {wheel.name}")

    name = canonicalize(raw_name)
    if name in records:
        raise SystemExit(f"Duplicate distribution in wheel set: {name}")

    digest = hashlib.sha256(wheel.read_bytes()).hexdigest()
    records[name] = (version, digest, wheel.name)

if "bittensor" not in records:
    raise SystemExit("The wheel set does not contain bittensor")
if "python-socks" not in records:
    raise SystemExit("The wheel set does not contain python-socks")
if records["bittensor"][0] != expected_bittensor:
    raise SystemExit(
        f"Downloaded Bittensor version mismatch: "
        f"expected {expected_bittensor}, got {records['bittensor'][0]}"
    )

python_tag = f"cp{sys.version_info.major}{sys.version_info.minor}"
platform_tag = f"{sys.platform}-{platform.machine().lower()}"

lines = [
    "# TensorCage complete wheel lock",
    f"# tensorcage-lock-version: {lock_version}",
    f"# bittensor-version: {expected_bittensor}",
    f"# python-tag: {python_tag}",
    f"# platform: {platform_tag}",
    "# Every non-comment line is an exact requirement with its approved wheel hash.",
]
for name in sorted(records):
    version, digest, filename = records[name]
    lines.append(f"# wheel: {filename}")
    lines.append(f"{name}=={version} --hash=sha256:{digest}")

output.write_text("\n".join(lines) + "\n", encoding="utf-8")
TENSORCAGE_CREATE_LOCK_PY

  chmod 0644 "$temp_lock"
  mv -f "$temp_lock" "$output_abs"

  if [[ "$secured_mode" == '1' ]]; then
    chown "$target_user:$target_group" "$output_abs"
  fi

  # Close PyPI before reporting success. Keeping the EXIT trap active until
  # this succeeds ensures failure remains fail-closed.
  if [[ "${TC_LOCK_CREATE_POLICY_OPENED:-0}" == '1' ]]; then
    log "Re-closing PyPI access after lock creation"
    apply_policy 0 0
    TC_LOCK_CREATE_POLICY_OPENED='0'
  fi

  trap - EXIT
  rm -rf -- "$tmpdir"

  TC_LOCK_CREATE_TMPDIR=''
  TC_LOCK_CREATE_TEMP_LOCK=''
  unset \
    TC_LOCK_CREATE_POLICY_OPENED \
    TC_LOCK_CREATE_TMPDIR \
    TC_LOCK_CREATE_TEMP_LOCK

  printf '\n%s\n' 'Lock manifest created successfully.'
  printf 'Path:   %s\n' "$output_abs"
  printf 'SHA256: %s\n' "$(sha256_file "$output_abs")"
  printf 'Mode:   %s\n' "$([[ "$secured_mode" == '1' ]] && printf 'secured-through-Dante' || printf 'trusted-host-direct')"
  printf '\nUse that single manifest hash when updating the secured machine.\n'
}

validate_bittensor_lock() {
  local lock_file="$1"
  local expected_lock_hash="$2"
  local expected_bittensor_version="$3"
  local actual_lock_hash=""

  [[ -f "$lock_file" && ! -L "$lock_file" ]] || {
    echo "Lock manifest must be a regular non-symlink file: $lock_file"
    exit 1
  }

  actual_lock_hash="$(sha256_file "$lock_file")"
  [[ "$actual_lock_hash" == "$expected_lock_hash" ]] || {
    echo "Lock manifest hash mismatch"
    echo "Expected: $expected_lock_hash"
    echo "Actual:   $actual_lock_hash"
    exit 1
  }

  TENSORCAGE_LOCK_FILE="$lock_file" \
  TENSORCAGE_BITTENSOR_VERSION="$expected_bittensor_version" \
    "$PYTHON_BIN" - <<'TENSORCAGE_VALIDATE_LOCK_PY'
import os
import platform
import re
import sys
from pathlib import Path

path = Path(os.environ["TENSORCAGE_LOCK_FILE"])
expected_bittensor = os.environ["TENSORCAGE_BITTENSOR_VERSION"]
text = path.read_text(encoding="utf-8")

headers: dict[str, str] = {}
requirements: dict[str, tuple[str, str]] = {}
pattern = re.compile(
    r"^([A-Za-z0-9][A-Za-z0-9._-]*)==([^\s]+) "
    r"--hash=sha256:([0-9a-fA-F]{64})$"
)

for raw_line in text.splitlines():
    line = raw_line.strip()
    if not line:
        continue
    if line.startswith("#"):
        header = line[1:].strip()
        if ":" in header:
            key, value = header.split(":", 1)
            headers[key.strip()] = value.strip()
        continue

    match = pattern.fullmatch(line)
    if not match:
        raise SystemExit(f"Unsafe or unsupported lock entry: {raw_line}")
    raw_name, version, digest = match.groups()
    name = re.sub(r"[-_.]+", "-", raw_name).lower()
    if name in requirements:
        raise SystemExit(f"Duplicate locked distribution: {name}")
    requirements[name] = (version, digest.lower())

if headers.get("tensorcage-lock-version") != "1":
    raise SystemExit("Unsupported or missing tensorcage-lock-version")
if headers.get("bittensor-version") != expected_bittensor:
    raise SystemExit("Lock manifest Bittensor version does not match the explicit version")

expected_python_tag = f"cp{sys.version_info.major}{sys.version_info.minor}"
if headers.get("python-tag") != expected_python_tag:
    raise SystemExit(
        f"Lock Python tag mismatch: expected {expected_python_tag}, "
        f"got {headers.get('python-tag')}"
    )

expected_platform = f"{sys.platform}-{platform.machine().lower()}"
if headers.get("platform") != expected_platform:
    raise SystemExit(
        f"Lock platform mismatch: expected {expected_platform}, "
        f"got {headers.get('platform')}"
    )

if "bittensor" not in requirements:
    raise SystemExit("Lock manifest does not contain bittensor")
if "python-socks" not in requirements:
    raise SystemExit("Lock manifest does not contain python-socks")
if requirements["bittensor"][0] != expected_bittensor:
    raise SystemExit("Locked Bittensor requirement has the wrong version")
if len(requirements) < 2:
    raise SystemExit("Lock manifest does not contain the dependency set")

print(f"Validated lock manifest with {len(requirements)} distributions")
TENSORCAGE_VALIDATE_LOCK_PY
}

verify_downloaded_wheel_set() {
  local lock_file="$1"
  local wheel_dir="$2"

  TENSORCAGE_LOCK_FILE="$lock_file" \
  TENSORCAGE_WHEEL_DIR="$wheel_dir" \
    "$PYTHON_BIN" - <<'TENSORCAGE_VERIFY_WHEELS_PY'
import email
import hashlib
import os
import re
import zipfile
from pathlib import Path

lock_file = Path(os.environ["TENSORCAGE_LOCK_FILE"])
wheel_dir = Path(os.environ["TENSORCAGE_WHEEL_DIR"])
pattern = re.compile(
    r"^([A-Za-z0-9][A-Za-z0-9._-]*)==([^\s]+) "
    r"--hash=sha256:([0-9a-fA-F]{64})$"
)


def canonicalize(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


expected: dict[str, tuple[str, str]] = {}
for raw_line in lock_file.read_text(encoding="utf-8").splitlines():
    match = pattern.fullmatch(raw_line.strip())
    if match:
        raw_name, version, digest = match.groups()
        expected[canonicalize(raw_name)] = (version, digest.lower())

actual: dict[str, tuple[str, str]] = {}
entries = list(wheel_dir.iterdir())
for entry in entries:
    if entry.is_symlink() or not entry.is_file() or entry.suffix != ".whl":
        raise SystemExit(f"Unexpected or unsafe download entry: {entry.name}")

    with zipfile.ZipFile(entry) as archive:
        metadata_names = [
            name for name in archive.namelist()
            if name.endswith(".dist-info/METADATA")
        ]
        if len(metadata_names) != 1:
            raise SystemExit(f"Expected one METADATA file in {entry.name}")
        message = email.message_from_bytes(archive.read(metadata_names[0]))

    raw_name = message.get("Name")
    version = message.get("Version")
    if not raw_name or not version:
        raise SystemExit(f"Missing metadata in {entry.name}")
    name = canonicalize(raw_name)
    if name in actual:
        raise SystemExit(f"Duplicate downloaded distribution: {name}")
    digest = hashlib.sha256(entry.read_bytes()).hexdigest()
    actual[name] = (version, digest)

if set(actual) != set(expected):
    missing = sorted(set(expected) - set(actual))
    unexpected = sorted(set(actual) - set(expected))
    raise SystemExit(
        f"Downloaded wheel set differs from lock; "
        f"missing={missing}, unexpected={unexpected}"
    )

for name, expected_value in expected.items():
    if actual[name] != expected_value:
        raise SystemExit(
            f"Wheel mismatch for {name}: expected={expected_value}, actual={actual[name]}"
        )

print(f"Verified {len(actual)} locked wheels; no missing or unexpected artifacts")
TENSORCAGE_VERIFY_WHEELS_PY
}

