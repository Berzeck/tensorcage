disable_tensorcage() {
  local dry_run="${1:-0}"

  if [[ "$dry_run" == "1" ]]; then
    cat <<EOF
TensorCage disable dry run
============================

Would disable:
  tensorcage-nft.service
  sockd
  unbound

Would deactivate TensorCage-managed containment state:
  /etc/systemd/system/tensorcage-nft.service
  /usr/local/sbin/tensorcage-nft-apply
  /etc/systemd/system/sockd.service.d
  active TensorCage nftables/firewalld rules and boot hooks
  TensorCage firewalld OUTPUT rules
  nftables table inet tensorcage

Would preserve:
  /opt/tensorcage and installed Python packages
  /usr/local/bin/tensorcage and /usr/local/bin/btc
  ~/.bittensor wallets and keys
  journals, package data, and timestamped configuration backups

Would switch DNS and firewalld back to maintenance defaults.
No changes were made.
EOF
    return 0
  fi

  log "Creating rollback snapshot before disable"
  create_rollback_snapshot "disable" >/dev/null || true
  log "Disabling TensorCage controls for maintenance"

  log "Backing up active TensorCage-related configs"
  backup_file /etc/sockd.conf
  backup_file /etc/unbound/unbound.conf
  backup_file /etc/zypp/zypp.conf
  backup_file /etc/pip.conf
  backup_file /etc/socks.conf
  backup_file /etc/sysconfig/network/config
  backup_file /etc/environment

  log "Stopping and disabling Dante, Unbound, and TensorCage nft service"
  systemctl disable --now tensorcage-nft.service 2>/dev/null || true
  systemctl disable --now sockd 2>/dev/null || true
  systemctl disable --now unbound 2>/dev/null || true

  log "Removing TensorCage outbound firewall direct rules"
  firewall-cmd --permanent --direct --remove-rules ipv4 filter OUTPUT 2>/dev/null || true
  firewall-cmd --permanent --direct --remove-rules ipv6 filter OUTPUT 2>/dev/null || true

  log "Removing TensorCage nftables service and boot hooks"
  rm -f /etc/systemd/system/tensorcage-nft.service
  rm -f /usr/local/sbin/tensorcage-nft-apply
  rm -rf /etc/systemd/system/sockd.service.d
  systemctl daemon-reload
  nft delete table inet tensorcage 2>/dev/null || true

  log "Disabling TensorCage proxy environment"
  if [[ -f /etc/profile.d/proxy.sh ]]; then
    mv /etc/profile.d/proxy.sh /etc/profile.d/proxy.sh.disabled
  fi

  sed -i '/127\.0\.0\.1:1080/d;/^http_proxy=/d;/^https_proxy=/d;/^HTTP_PROXY=/d;/^HTTPS_PROXY=/d' /etc/environment 2>/dev/null || true
  sed -i '/proxy=http:\/\/127\.0\.0\.1:1080/d;/^proxy=/d' /etc/zypp/zypp.conf 2>/dev/null || true

  log "Restoring external DNS for maintenance mode"
  local CFG=/etc/sysconfig/network/config
  set_kv "NETCONFIG_DNS_POLICY" "STATIC" "$CFG"
  set_kv "NETCONFIG_DNS_STATIC_SERVERS" "1.1.1.1 8.8.8.8" "$CFG"
  netconfig update -f || true

  log "Disabling pip proxy for maintenance mode"
  if [[ -f /etc/pip.conf ]]; then
    sed -i '/proxy *= *http:\/\/127\.0\.0\.1:1080/d' /etc/pip.conf 2>/dev/null || true
  fi

  log "Restoring firewalld default zone to public"
  firewall-cmd --set-default-zone=public 2>/dev/null || true
  firewall-cmd --reload 2>/dev/null || true

  set_lifecycle_state "DISABLED"

  log "TensorCage disabled for maintenance."
  echo
  echo "TensorCage controls are disabled for maintenance."
  echo "Packages, logs, keys, and config backups were preserved."
  echo
  echo "To re-enable protection later, run:"
  echo "  sudo /usr/local/bin/tensorcage enable"
}


enable_tensorcage() {
  require_baseline_install
  log "Creating rollback snapshot before enable"
  create_rollback_snapshot "enable" >/dev/null

  systemctl enable --now firewalld
  render_unbound_conf
  render_unbound_allowlist 0 0
  render_dante_conf 0 0
  render_dante_client_conf
  configure_sockd_systemd_override
  systemctl daemon-reload
  systemctl enable --now sockd unbound

  configure_firewall_containment
  configure_nft_containment_service
  configure_chrony

  local CFG=/etc/sysconfig/network/config
  set_kv "NETCONFIG_DNS_POLICY" "STATIC" "$CFG"
  set_kv "NETCONFIG_DNS_STATIC_SERVERS" "${DNS_LOCAL_IP}" "$CFG"
  netconfig update -m dns

  install_btc_wrapper
  refresh_managed_integrity_manifest
  run_doctor
  set_lifecycle_state "ENABLED"
  log "TensorCage enabled successfully"
}

status_tensorcage() {
  local installed="NO"
  local enabled="NO"
  local healthy="NOT APPLICABLE"
  local integrity="NOT APPLICABLE"
  local recommendation=""
  local local_health_ok="1"

  if [[ -x /usr/local/bin/tensorcage && -x "$PYTHON_BIN" ]]; then
    installed="YES"
  fi

  if systemctl is-active --quiet tensorcage-nft.service 2>/dev/null \
    && systemctl is-active --quiet sockd 2>/dev/null \
    && systemctl is-active --quiet unbound 2>/dev/null \
    && firewall-cmd --direct --get-all-rules 2>/dev/null | grep -q 'ipv4 filter OUTPUT 100 -j DROP' \
    && firewall-cmd --direct --get-all-rules 2>/dev/null | grep -q 'ipv6 filter OUTPUT 100 -j DROP' \
    && nft list table inet tensorcage >/dev/null 2>&1; then
    enabled="YES"
  fi

  if [[ "$installed" == "YES" ]]; then
    if verify_managed_integrity_manifest >/dev/null 2>&1; then
      integrity="PASS"
    else
      integrity="FAIL"
      local_health_ok="0"
    fi
  fi

  if [[ "$installed" == "YES" && "$enabled" == "YES" ]]; then
    systemctl is-active --quiet firewalld 2>/dev/null || local_health_ok="0"
    systemctl is-active --quiet chronyd 2>/dev/null || local_health_ok="0"
    ss -lnt 2>/dev/null | grep -qE '127[.]0[.]0[.]1:1080[[:space:]]' || local_health_ok="0"
    ss -lntu 2>/dev/null | grep -qE '127[.]0[.]0[.]1:53[[:space:]]' || local_health_ok="0"
    LC_ALL=C chronyc tracking 2>/dev/null | grep -q '^Leap status[[:space:]]*:[[:space:]]*Normal' || local_health_ok="0"

    if [[ "$local_health_ok" == "1" ]]; then
      healthy="YES"
    else
      healthy="NO"
      recommendation="sudo /usr/local/bin/tensorcage doctor"
    fi
  elif [[ "$installed" == "YES" ]]; then
    recommendation="sudo /usr/local/bin/tensorcage enable"
  else
    recommendation="sudo ./tensorcage install"
  fi

  cat <<EOF
TensorCage status
