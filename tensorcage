# Render functions
########################################

render_dante_conf() {
  local allow_pypi="${1:-0}"
  local allow_os="${2:-0}"
  local ext_if
  local tmpfile
  local rule
  local destination
  local port
  local pypi_ip
  local pypi_ips=()

  : "$allow_os" # Reserved for future Dante-routed OS maintenance.

  ext_if="$(ip -4 route show default | awk '{print $5}' | head -n1)"
  [[ -n "$ext_if" ]] || {
    echo "Could not determine the default IPv4 interface."
    return 1
  }

  if [[ "$allow_pypi" == "1" ]]; then
    while IFS= read -r pypi_ip; do
      [[ -n "$pypi_ip" ]] && pypi_ips+=("$pypi_ip")
    done < <(resolve_ipv4_hosts PYPI_EGRESS_HOSTS)

    [[ "${#pypi_ips[@]}" -gt 0 ]] || {
      echo "Refusing to open PyPI mode without resolved destination addresses."
      return 1
    }
  fi

  if [[ -L /etc/sockd.conf ]]; then
    echo "Refusing to replace symbolic link: /etc/sockd.conf"
    return 1
  fi

  backup_file /etc/sockd.conf
  tmpfile="$(mktemp /etc/sockd.conf.tensorcage.XXXXXX)"

  cat > "$tmpfile" <<EOF
logoutput: syslog
errorlog: syslog

internal: ${LOCAL_PROXY_IP} port = ${DANTE_PORT}
external: ${ext_if}

user.privileged: root
user.unprivileged: nobody

socksmethod: none
clientmethod: none

client pass {
    from: 127.0.0.0/8 to: 0.0.0.0/0
    log: connect error
}

# Runtime Bittensor destinations.
EOF

  for rule in "${DANTE_RUNTIME_RULES[@]}"; do
    destination="${rule%:*}"
    port="${rule##*:}"
    append_dante_pass_rule "$destination" "$port" "$tmpfile"
  done

  if [[ "$allow_pypi" == "1" ]]; then
    cat >> "$tmpfile" <<'EOF'

# Temporary PyPI destinations resolved immediately before this policy was applied.
EOF
    for pypi_ip in "${pypi_ips[@]}"; do
      append_dante_pass_rule "${pypi_ip}/32" "443" "$tmpfile"
    done
  fi

  cat >> "$tmpfile" <<'EOF'

socks block {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect error
}
EOF

  chown root:root "$tmpfile"
  chmod 0600 "$tmpfile"
  /usr/sbin/sockd -V -f "$tmpfile"
  mv -f "$tmpfile" /etc/sockd.conf
  systemctl restart sockd
}

render_dante_client_conf() {
  log "Configuring Dante socksify client"

  if [[ -L /etc/socks.conf ]]; then
    echo "Refusing to replace symbolic link: /etc/socks.conf"
    exit 1
  fi

  backup_file /etc/socks.conf

  local tmpfile
  tmpfile="$(mktemp /etc/socks.conf.tensorcage.XXXXXX)"

  cat > "$tmpfile" <<EOF
# Managed by ${APP_NAME} ${APP_VERSION}
# Route all socksified TCP connections through the local Dante server.
resolveprotocol: fake

route {
  from: 0.0.0.0/0 to: 0.0.0.0/0 via: ${LOCAL_PROXY_IP} port = ${DANTE_PORT}
  command: connect
  protocol: tcp
  proxyprotocol: socks_v5
  method: none
}

route {
  from: 0.0.0.0/0 to: . via: ${LOCAL_PROXY_IP} port = ${DANTE_PORT}
  command: connect
  protocol: tcp
  proxyprotocol: socks_v5
  method: none
}
EOF

  chown root:root "$tmpfile"
  chmod 0644 "$tmpfile"
  mv -f "$tmpfile" /etc/socks.conf
}

install_btc_wrapper() {
  log "Installing unified btcli wrapper"

  if [[ -L /usr/local/bin/btc ]]; then
    echo "Refusing to replace symbolic link: /usr/local/bin/btc"
    exit 1
  fi

  backup_file /usr/local/bin/btc

  local tmpfile
  tmpfile="$(mktemp /usr/local/bin/btc.tensorcage.XXXXXX)"

  cat > "$tmpfile" <<'EOF'
#!/usr/bin/env bash

unset \
  http_proxy \
  https_proxy \
  HTTP_PROXY \
  HTTPS_PROXY \
  ALL_PROXY \
  all_proxy \
  WSS_PROXY \
  WS_PROXY \
  NO_PROXY

# Bittensor 11 uses websockets' native asynchronous proxy support.
# SOCKS5h keeps endpoint DNS resolution inside the local Dante path.
export wss_proxy='socks5h://127.0.0.1:1080'
export ws_proxy='socks5h://127.0.0.1:1080'
export no_proxy='127.0.0.1,localhost,::1'

/usr/bin/logger -t tensorcage-btc -- \
  "uid=$(id -u) pid=$$ invoked unified btcli via native SOCKS" 2>/dev/null || true

exec /opt/tensorcage/venv/bin/btcli "$@"
EOF

  chown root:root "$tmpfile"
  chmod 0755 "$tmpfile"
  mv -f "$tmpfile" /usr/local/bin/btc
}

verify_socksified_python_egress() {
  local target_user="$1"
  local target_home="$2"

  log "Verifying Python egress through Dante"

  runuser -u "$target_user" -- env \
    HOME="$target_home" \
    PATH="/opt/tensorcage/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    SOCKS_CONF='/etc/socks.conf' \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    /usr/bin/socksify "$PYTHON_BIN" - <<'TENSORCAGE_SOCKS_TEST_PY'
import urllib.request

request = urllib.request.Request(
    "https://pypi.org/simple/bittensor/",
    headers={"User-Agent": "TensorCage egress preflight"},
)
with urllib.request.urlopen(request, timeout=20) as response:
    status = response.status
    print(f"PyPI SOCKS preflight HTTP status: {status}")
    if status < 200 or status >= 400:
        raise SystemExit(f"Unexpected PyPI HTTP status: {status}")
TENSORCAGE_SOCKS_TEST_PY
}

render_unbound_conf() {
  require_command unbound-checkconf

  backup_file /etc/unbound/unbound.conf

  local forwarders=""
  for dns_ip in "${UPSTREAM_DNS_SERVERS[@]}"; do
    forwarders="${forwarders}  forward-addr: ${dns_ip}\n"
  done

  cat > /etc/unbound/unbound.conf <<EOF
server:
  interface: ${DNS_LOCAL_IP}
  port: ${UNBOUND_PORT}
  access-control: 127.0.0.0/8 allow

  username: "unbound"
  directory: "/etc/unbound"
  chroot: ""
  pidfile: "/run/unbound/unbound.pid"

  hide-identity: yes
  hide-version: yes
  qname-minimisation: yes
  harden-glue: yes
  harden-dnssec-stripped: yes
  ratelimit: 100
  use-syslog: yes
  verbosity: 1

# Cache Tuning for CLI responsiveness
  prefetch: yes
  prefetch-key: yes
  cache-min-ttl: 600
  serve-expired: yes
  msg-cache-size: 8m
  rrset-cache-size: 16m

forward-zone:
  name: "."
$(printf "$forwarders")

include: "/etc/unbound/allowlist/domains.conf"
EOF

}

render_unbound_allowlist() {
  local allow_pypi="${1:-0}"
  local allow_os="${2:-0}"

  require_command unbound-checkconf

  mkdir -p /etc/unbound/allowlist

  {
    echo "server:"
    for domain in "${BT_DNS_DOMAINS[@]}"; do
      echo "  local-zone: \"${domain}\" transparent"
    done
    if [[ "$allow_os" == "1" ]]; then
      for domain in "${OPENSUSE_DNS_DOMAINS[@]}"; do
        echo "  local-zone: \"${domain}\" transparent"
      done
    fi
    if [[ "$allow_pypi" == "1" ]]; then
      for domain in "${PYPI_DNS_DOMAINS[@]}"; do
        echo "  local-zone: \"${domain}\" transparent"
      done
    fi
    echo '  local-zone: "." refuse'
  } > /etc/unbound/allowlist/domains.conf

  mkdir -p /run/unbound
  chown unbound:unbound /run/unbound
  chmod 0755 /run/unbound
  unbound-checkconf /etc/unbound/unbound.conf
  systemctl restart unbound
}

apply_policy() {
  local allow_pypi="${1:-0}"
  local allow_os="${2:-0}"

  log "Applying policy (allow_pypi=${allow_pypi}, allow_os=${allow_os})"
  # Open DNS first so temporary destinations can be resolved, then narrow Dante
  # to the exact addresses returned. Closing follows the same fail-closed path.
  render_unbound_allowlist "$allow_pypi" "$allow_os"
  render_dante_conf "$allow_pypi" "$allow_os"
}


render_chrony_conf() {
  require_command chronyd

  log "Configuring Chrony with pinned NTP servers"

  if [[ -L /etc/chrony.conf ]]; then
    echo "Refusing to replace symbolic link: /etc/chrony.conf"
    exit 1
  fi

  backup_file /etc/chrony.conf

  local tmpfile
  local ntp_ip
  tmpfile="$(mktemp /etc/chrony.conf.tensorcage.XXXXXX)"

  {
    echo "# Managed by ${APP_NAME} ${APP_VERSION}"
    echo "# DNS-independent NTP configuration using pinned server IPs."
    for ntp_ip in "${NTP_IPS[@]}"; do
      echo "server ${ntp_ip} iburst"
    done
    echo
    echo "driftfile /var/lib/chrony/drift"
    echo "makestep 1.0 3"
    echo "rtcsync"
    echo "cmdport 0"
  } > "$tmpfile"

  chown root:root "$tmpfile"
  chmod 0644 "$tmpfile"

  chronyd -p -f "$tmpfile" >/dev/null
  mv -f "$tmpfile" /etc/chrony.conf
}

verify_chrony_sync() {
  require_command chronyc

  log "Waiting for Chrony synchronization"

  chronyc online >/dev/null 2>&1 || true
  chronyc makestep 0.1 1 >/dev/null 2>&1 || true
  chronyc burst 4/4 >/dev/null 2>&1 || true

  # Wait for a selected source and for the remaining correction reported by
  # tracking to be below the configured threshold. waitsync is the native
  # chrony primitive for this purpose.
  if ! chronyc waitsync 30 "$CHRONY_MAX_CORRECTION_SECONDS" 0 2 >/dev/null 2>&1; then
    echo "Chrony did not reach the required synchronization threshold."
    echo
    chronyc tracking 2>/dev/null || true
    echo
    chronyc -n sources -v 2>/dev/null || true
    return 1
  fi

  chronyc makestep >/dev/null 2>&1 || true

  local attempt
  local tracking
  local last_offset
  for attempt in $(seq 1 30); do
    tracking="$(LC_ALL=C chronyc tracking 2>/dev/null || true)"
    last_offset="$(printf '%s
' "$tracking" | awk -F: '/^Last offset/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}')"

    if LC_ALL=C chronyc sources 2>/dev/null | grep -q '^[#^][*]' && \
       printf '%s
' "$tracking" | grep -q 'Leap status[[:space:]]*:[[:space:]]*Normal' && \
       [[ -n "$last_offset" ]] && \
       awk -v value="$last_offset" 'BEGIN { if (value < 0) value = -value; exit !(value < 1.0) }'; then
      log "Chrony synchronized successfully"
      return 0
    fi

    sleep 2
  done

  echo "Chrony selected a source, but its post-step offset did not stabilize below 1 second."
  echo
  chronyc tracking 2>/dev/null || true
  echo
  chronyc -n sources -v 2>/dev/null || true
  return 1
}

configure_chrony() {
  render_chrony_conf
  systemctl enable --now chronyd
  systemctl restart chronyd
  verify_chrony_sync
}

configure_sockd_systemd_override() {
  log "Configuring sockd startup ordering"
  mkdir -p /etc/systemd/system/sockd.service.d
  cat > /etc/systemd/system/sockd.service.d/override.conf <<'EOF'
[Unit]
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Restart=on-failure
RestartSec=5
EOF
  systemctl daemon-reload
}

configure_nft_containment_service() {
  log "Configuring persistent nftables containment service"

  local target_user
  local target_uid
  target_user="$(get_target_user)"
  target_uid="$(id -u "$target_user")"

  cat > /usr/local/sbin/tensorcage-nft-apply <<EOF
#!/usr/bin/env bash
set -euo pipefail

cat > /run/tensorcage.nft <<'NFT'
table inet tensorcage {
  chain output {
    type filter hook output priority -50; policy accept;

    ct state established,related accept

    # Only root and the designated TensorCage operator may use the local
    # SOCKS listener. Other local users are denied before the generic
    # loopback allowance.
    ip daddr 127.0.0.1 tcp dport 1080 meta skuid { 0, ${target_uid} } accept
    ip daddr 127.0.0.1 tcp dport 1080 log prefix "TC_DENY_SOCKS_LOCAL: " drop

    oif "lo" accept

    ip daddr 127.0.0.1 udp dport 53 accept
    ip daddr 127.0.0.1 tcp dport 53 accept

    meta skuid unbound ip daddr { 1.1.1.1, 8.8.8.8 } udp dport 53 accept
    meta skuid unbound ip daddr { 1.1.1.1, 8.8.8.8 } tcp dport 53 accept
    meta skuid nobody tcp dport { 80, 443, 9944 } accept

    # No direct user egress exception: btcli must traverse Dante so the
    # destination allowlist and logging cannot be bypassed.

    meta skuid root udp sport 68 udp dport 67 accept
    udp sport 67 udp dport 68 accept

    meta skuid root ip daddr { 162.159.200.1, 162.159.200.123 } udp dport 123 accept
    meta skuid chrony ip daddr { 162.159.200.1, 162.159.200.123 } udp dport 123 accept

    log prefix "TC_DROP: " drop
  }
}
NFT

nft delete table inet tensorcage 2>/dev/null || true
nft -f /run/tensorcage.nft
EOF

  chmod 700 /usr/local/sbin/tensorcage-nft-apply

  cat > /etc/systemd/system/tensorcage-nft.service <<'EOF'
[Unit]
Description=Apply TensorCage nftables outbound containment
After=network-pre.target
Before=network-online.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tensorcage-nft-apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable --now tensorcage-nft.service
}

open_root_nft_maintenance_gate() {
  log "Opening temporary nft maintenance gate for root"

  systemctl stop tensorcage-nft.service 2>/dev/null || true
  nft delete table inet tensorcage 2>/dev/null || true

  cat > /run/tensorcage-maintenance.nft <<'NFT'
table inet tensorcage {
  chain output {
    type filter hook output priority 0; policy accept;

    ct state established,related accept
    oif "lo" accept

    meta skuid root udp dport 53 accept
    meta skuid root tcp dport 53 accept
    meta skuid root tcp dport { 80, 443 } accept

    log prefix "TC_DROP: " drop
  }
}
NFT

  nft -f /run/tensorcage-maintenance.nft
}

close_root_nft_maintenance_gate() {
  log "Re-closing temporary nft maintenance gate"

  nft delete table inet tensorcage 2>/dev/null || true
  systemctl restart tensorcage-nft.service 2>/dev/null || true
}

########################################
# Baseline install/config mode
########################################

set_lifecycle_state() {
  local state="$1"
  install -d -o root -g root -m 0700 "$TENSORCAGE_STATE_DIR"
  printf '%s\n' "$state" > "$LIFECYCLE_STATE_FILE"
  chown root:root "$LIFECYCLE_STATE_FILE"
  chmod 0600 "$LIFECYCLE_STATE_FILE"
}

require_enabled_state() {
  if ! systemctl is-active --quiet tensorcage-nft.service 2>/dev/null \
    || ! systemctl is-active --quiet sockd 2>/dev/null \
    || ! systemctl is-active --quiet unbound 2>/dev/null; then
    echo "TensorCage is installed but not enabled."
    echo "Run: sudo /usr/local/bin/tensorcage enable"
    return 1
  fi
}

configure_firewall_containment() {
  log "Configuring firewall rules"
  local DANTE_UID
  local UNBOUND_UID
  local ntp_ip
  local dns_ip
  local port

  DANTE_UID="$(id -u nobody)"
  UNBOUND_UID="$(id -u unbound)"

  # Flush existing TensorCage rules so re-installing doesn't fail
  firewall-cmd --permanent --direct --remove-rules ipv4 filter OUTPUT >/dev/null 2>&1 || true
  firewall-cmd --permanent --direct --remove-rules ipv6 filter OUTPUT >/dev/null 2>&1 || true

  firewall-cmd --permanent --add-service=ssh >/dev/null 2>&1 || true

  add_direct_rule_once ipv4 filter INPUT 0 -p tcp --dport 22 -j ACCEPT
  add_direct_rule_once ipv6 filter INPUT 0 -p tcp --dport 22 -j ACCEPT

  add_direct_rule_once ipv4 filter INPUT 0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  add_direct_rule_once ipv6 filter INPUT 0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  add_direct_rule_once ipv4 filter OUTPUT 0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  add_direct_rule_once ipv6 filter OUTPUT 0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

  add_direct_rule_once ipv4 filter INPUT 0 -i lo -j ACCEPT
  add_direct_rule_once ipv6 filter INPUT 0 -i lo -j ACCEPT
  add_direct_rule_once ipv4 filter OUTPUT 0 -o lo -j ACCEPT
  add_direct_rule_once ipv6 filter OUTPUT 0 -o lo -j ACCEPT

  add_direct_rule_once ipv4 filter OUTPUT 0 -d "${LOCAL_PROXY_IP}" -p tcp --dport "${DANTE_PORT}" -j ACCEPT

  add_direct_rule_once ipv4 filter OUTPUT 0 -d "${DNS_LOCAL_IP}" -p udp --dport "${UNBOUND_PORT}" -j ACCEPT
  add_direct_rule_once ipv4 filter OUTPUT 0 -d "${DNS_LOCAL_IP}" -p tcp --dport "${UNBOUND_PORT}" -j ACCEPT

  for dns_ip in "${UPSTREAM_DNS_SERVERS[@]}"; do
    add_direct_rule_once ipv4 filter OUTPUT 5 -m owner --uid-owner "${UNBOUND_UID}" -p udp -d "${dns_ip}" --dport 53 -j ACCEPT
    add_direct_rule_once ipv4 filter OUTPUT 5 -m owner --uid-owner "${UNBOUND_UID}" -p tcp -d "${dns_ip}" --dport 53 -j ACCEPT
  done

  add_direct_rule_once ipv4 filter OUTPUT 0 -p udp -m owner --uid-owner root --sport 68 --dport 67 -j ACCEPT
  add_direct_rule_once ipv4 filter INPUT 0 -p udp --sport 67 --dport 68 -j ACCEPT

  for port in "${DANTE_EGRESS_PORTS[@]}"; do
    add_direct_rule_once ipv4 filter OUTPUT 5 -m owner --uid-owner "${DANTE_UID}" -p tcp --dport "${port}" -j ACCEPT
  done

  for ntp_ip in "${NTP_IPS[@]}"; do
    add_direct_rule_once ipv4 filter OUTPUT 0 -p udp -m owner --uid-owner root -d "${ntp_ip}" --dport 123 -j ACCEPT
    if id chrony >/dev/null 2>&1; then
      add_direct_rule_once ipv4 filter OUTPUT 0 -p udp -m owner --uid-owner chrony -d "${ntp_ip}" --dport 123 -j ACCEPT
    fi
  done
  # Log unauthorized outbound attempts right before they hit the DROP rule
  add_direct_rule_once ipv4 filter OUTPUT 99 -j LOG --log-prefix "TC_DROP: "
  add_direct_rule_once ipv6 filter OUTPUT 99 -j LOG --log-prefix "TC_DROP: "

  add_direct_rule_once ipv4 filter OUTPUT 100 -j DROP
  add_direct_rule_once ipv6 filter OUTPUT 100 -j DROP

  firewall-cmd --set-default-zone=drop >/dev/null 2>&1 || {
    echo "Failed to set firewalld default zone to drop" >&2
    return 1
  }
  firewall-cmd --reload >/dev/null 2>&1 || {
    echo "Failed to reload firewalld" >&2
    return 1
  }
}

baseline_setup() {
  if [[ -f "$LIFECYCLE_STATE_FILE" ]]; then
    echo "TensorCage is already installed."
    echo "Use 'tensorcage enable' to restore protection or 'tensorcage status' to inspect state."
    return 1
  fi
  print_banner
  confirm_install
  detect_opensuse_leap

  log "Enabling firewalld and clearing previous cage"
  systemctl enable --now firewalld

  # MOVE THE FLUSH HERE (To the very top)
  firewall-cmd --permanent --direct --remove-rules ipv4 filter OUTPUT || true
  firewall-cmd --permanent --direct --remove-rules ipv6 filter OUTPUT || true

  log "Enabling kernel-level logging for dropped unicast packets"
  firewall-cmd --set-log-denied=unicast
  firewall-cmd --reload

  log "Temporarily restoring public DNS for installation"
  # This ensures zypper can resolve names before Unbound is ready
  echo "nameserver 1.1.1.1" > /etc/resolv.conf

  open_root_nft_maintenance_gate

  log "Refreshing repos"
  zypper refresh

  log "Installing required packages"
  zypper install -y dante-server unbound dante chrony

  require_command sockd
  require_command unbound-checkconf
  require_command netconfig
  require_command socksify
  require_command chronyd
  require_command chronyc

  log "Preparing Unbound runtime directory"
  mkdir -p /run/unbound
  chown unbound:unbound /run/unbound
  chmod 0755 /run/unbound

  log "Configuring Unbound"
  render_unbound_conf

  mkdir -p /etc/systemd/system/unbound.service.d
  cat > /etc/systemd/system/unbound.service.d/runtime.conf <<'EOF'
[Service]
RuntimeDirectory=unbound
RuntimeDirectoryMode=0755
EOF

  systemctl daemon-reload

  log "Configuring initial policy with PyPI closed"
  render_unbound_allowlist 0 0
  render_dante_conf 0 0

  mkdir -p /run/unbound
  chown unbound:unbound /run/unbound
  chmod 0755 /run/unbound
  unbound-checkconf /etc/unbound/unbound.conf

  log "Starting services"
  systemctl enable --now sockd
  systemctl enable --now unbound

  configure_firewall_containment
  configure_sockd_systemd_override
  configure_nft_containment_service

  configure_chrony

  log "Configuring netconfig DNS"
  local CFG=/etc/sysconfig/network/config
  backup_file "$CFG"
  set_kv "NETCONFIG_DNS_POLICY" "STATIC" "$CFG"
  set_kv "NETCONFIG_DNS_STATIC_SERVERS" "${DNS_LOCAL_IP}" "$CFG"
  netconfig update -m dns

  log "Configuring zypper proxy"
  backup_file /etc/zypp/zypp.conf

  if grep -q '^ *download.use_deltarpm' /etc/zypp/zypp.conf; then
    sed -i 's/^ *download\.use_deltarpm.*/download.use_deltarpm = false/' /etc/zypp/zypp.conf
  else
    echo 'download.use_deltarpm = false' >> /etc/zypp/zypp.conf
  fi

  configure_repos

  render_dante_client_conf

  install_btc_wrapper

  refresh_managed_integrity_manifest
  set_lifecycle_state "ENABLED"

  log "Machine secured successfully."
  echo
  echo "TensorCage install completed successfully."
  echo "Machine secured."
}

create_rollback_snapshot() {
  local reason="$1"
  local stamp=""
  local destination=""
  local path=""

  stamp="$(date -u '+%Y%m%dT%H%M%SZ')"
  destination="${ROLLBACK_ROOT}/${stamp}-${reason}"
  install -d -o root -g root -m 0700 "$destination/files"

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ -f "$path" && ! -L "$path" ]]; then
      install -D -o root -g root -m "$(stat -c '%a' "$path")"         "$path" "${destination}/files${path}"
    fi
  done < <(managed_integrity_paths)

  firewall-cmd --direct --get-all-rules > "${destination}/firewalld-direct.rules" 2>/dev/null || true
  nft list table inet tensorcage > "${destination}/tensorcage.nft" 2>/dev/null || true
  chown -R root:root "$destination"
  chmod -R go-rwx "$destination"
  printf '%s\n' "$destination"
}

sync_runtime_policy() {
  require_baseline_install
  log "Creating rollback snapshot before policy synchronization"
  create_rollback_snapshot "policy-sync" >/dev/null

  log "Reapplying closed TensorCage runtime policy"
  render_dante_client_conf
  install_btc_wrapper
  apply_policy 0 0
  configure_nft_containment_service

  systemctl is-active --quiet sockd || {
    echo "sockd is not active after policy synchronization."
    return 1
  }
  systemctl is-active --quiet unbound || {
    echo "unbound is not active after policy synchronization."
    return 1
  }
  systemctl is-active --quiet tensorcage-nft.service || {
    echo "tensorcage-nft.service is not active after policy synchronization."
    return 1
  }

  refresh_managed_integrity_manifest

  log "Closed runtime policy synchronized successfully"
}

