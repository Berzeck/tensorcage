# Main
########################################

case "$COMMAND" in
  install) baseline_setup ;;
  enable) enable_tensorcage ;;
  disable) disable_tensorcage "$DISABLE_DRY_RUN" ;;
  status) status_tensorcage ;;
  lock-create) create_bittensor_lock "$BITTENSOR_VERSION" "$LOCK_OUTPUT" ;;
  lock-verify) verify_lock_command ;;
  update) update_bittensor "$BITTENSOR_VERSION" "$LOCK_FILE" "$LOCK_HASH" ;;
  doctor) run_doctor ;;
  info) show_info ;;
  uninstall) uninstall_tensorcage "$UNINSTALL_DRY_RUN" ;;
  _policy-sync) sync_runtime_policy ;;
  _time-sync) time_sync_command ;;
  _os-update) os_update ;;
  _os-upgrade) os_upgrade ;;
  _diff) show_managed_diff ;;
  _selftest) run_doctor ;;
  _test) run_focused_test "$TEST_TARGET" ;;
  *) usage; exit 1 ;;
esac
